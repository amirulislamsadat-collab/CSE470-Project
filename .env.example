# Copy this file to .env and fill in your own values.
# Local development (XAMPP MySQL) defaults are shown below.

PORT=3000

# --- MySQL Connection (XAMPP default: host=127.0.0.1, user=root, no password) ---
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=alms_db
DB_PORT=3306

# --- Session ---
SESSION_SECRET=change-this-to-a-long-random-string
