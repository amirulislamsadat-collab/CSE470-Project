<%- include('header', { currentPath: '/expenses' }) %>
<div class="page">
  <div class="top">
    <div>
      <a href="/modules/finance" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Finance Tracker</a>
      <h1><i class="fas fa-money-bill-wave" aria-hidden="true"></i> Expenses &amp; Income</h1>
      <div class="page-desc">Record and categorize your income and expenses.</div>
    </div>
    <a class="btn primary" href="/expenses/new" id="newExpenseBtn"><i class="fas fa-plus" aria-hidden="true"></i> New Entry</a>
  </div>

  <div class="summary-strip" style="margin-bottom:32px;">
    <div class="summary-tile"><div class="val amount-income">$<%= summary.totalIncome.toFixed(2) %></div><div class="lbl">Total Income</div></div>
    <div class="summary-tile"><div class="val amount-expense">$<%= summary.totalExpense.toFixed(2) %></div><div class="lbl">Total Expenses</div></div>
    <div class="summary-tile"><div class="val <%= summary.balance >= 0 ? 'amount-income' : 'amount-expense' %>">$<%= summary.balance.toFixed(2) %></div><div class="lbl">Balance</div></div>
  </div>

  <% if(expenses.length){ %>
  <div class="list">
    <% expenses.forEach(e => { %>
    <div class="item">
      <div class="item-body">
        <div class="item-title"><%= e.category %> <span class="<%= e.type === 'income' ? 'amount-income' : 'amount-expense' %>">&mdash; <%= e.type === 'income' ? '+' : '-' %>$<%= parseFloat(e.amount).toFixed(2) %></span></div>
        <div class="meta">
          <span class="<%= e.type === 'income' ? 'badge-income' : 'badge-expense' %>"><%= e.type %></span>
          <span><i class="fas fa-calendar-day" aria-hidden="true"></i> <%= new Date(e.expense_date).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) %></span>
        </div>
        <% if(e.description){ %><div class="meta item-desc"><%= e.description %></div><% } %>
      </div>
      <div class="actions">
        <a href="/expenses/edit/<%= e.id %>" class="btn secondary btn-sm" id="editExpense<%= e.id %>"><i class="fas fa-edit" aria-hidden="true"></i> Edit</a>
        <form method="POST" action="/expenses/delete/<%= e.id %>" style="display:inline" onsubmit="return confirm('Delete this entry?');">
          <button type="submit" class="btn danger btn-sm" id="deleteExpense<%= e.id %>"><i class="fas fa-trash-alt" aria-hidden="true"></i> Delete</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="empty-state">
    <div class="empty-icon"><i class="fas fa-money-bill-wave" aria-hidden="true"></i></div>
    <h3>No entries yet</h3>
    <p>Add your first income or expense to start tracking your budget.</p>
    <a href="/expenses/new" class="btn primary" id="createFirstExpense"><i class="fas fa-plus" aria-hidden="true"></i> New Entry</a>
  </div>
  <% } %>
</div>
<%- include('footer') %>
