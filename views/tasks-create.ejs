<%- include('header', { currentPath: '/tasks' }) %>
<%
  const currentTask = task || null;
  const action = typeof formAction !== 'undefined' ? formAction : '/tasks/create';
  const titleValue = currentTask ? currentTask.title : '';
  const descriptionValue = currentTask ? currentTask.description || '' : '';
  const submitText = typeof submitLabel !== 'undefined' ? submitLabel : 'Save Task';
%>
<style>
.page { padding: 32px; max-width: 900px; margin: 0 auto; }
.top-nav { margin-bottom: 24px; }
.back-link {
  color: #9ca3af;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  background: #111827;
  border: 1px solid #1e293b;
  border-radius: 8px;
}
.form-card {
  background: #111827;
  border: 1px solid #1e293b;
  border-radius: 16px;
  padding: 40px;
}
.form-header {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 24px;
  font-weight: 700;
  color: #f9fafb;
  margin-bottom: 32px;
  padding-bottom: 24px;
  border-bottom: 1px solid #1e293b;
}
.form-group { margin-bottom: 24px; }
.form-label {
  display: block;
  font-size: 11px;
  font-weight: 700;
  color: #9ca3af;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 10px;
}
.form-control {
  width: 100%;
  background: #0b0f19;
  border: 1px solid #1e293b;
  color: #f9fafb;
  font-family: inherit;
  font-size: 15px;
  padding: 14px 16px;
  border-radius: 10px;
  outline: none;
  transition: border-color 0s;
}
.form-control:focus {
  border-color: #4f46e5;
  box-shadow: 0 0 0 1px #4f46e5;
}
textarea.form-control { resize: vertical; min-height: 120px; }

.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }

.radio-group { display: flex; gap: 12px; }
.radio-group label {
  flex: 1;
  background: #0b0f19;
  border: 1px solid #1e293b;
  border-radius: 10px;
  padding: 14px;
  text-align: center;
  color: #9ca3af;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  transition: all 0s;
}
.radio-group input[type="radio"] { display: none; }
.radio-group input[type="radio"]:checked + label {
  background: rgba(245, 158, 11, 0.05);
  border-color: #f59e0b;
  color: #f59e0b;
}
.radio-group input[value="low"]:checked + label { background: rgba(16, 185, 129, 0.05); border-color: #10b981; color: #10b981; }
.radio-group input[value="high"]:checked + label { background: rgba(239, 68, 68, 0.05); border-color: #ef4444; color: #ef4444; }
.r-icon { font-size: 18px; }

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16px;
  margin-top: 40px;
  padding-top: 24px;
  border-top: 1px solid #1e293b;
}
.btn {
  padding: 12px 24px;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  font-family: inherit;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  border: none;
}
.btn-cancel {
  background: transparent;
  color: #9ca3af;
  border: 1px solid #374151;
}
.btn-save {
  background: #4f46e5;
  color: #fff;
}
</style>

<div class="page">
  <div class="top-nav">
    <a href="/tasks/hub" class="back-link">← Back to Tasks</a>
  </div>

  <form action="<%= action %>" method="POST" class="form-card">
    <div class="form-header">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
      <%= pageTitle || 'Create New Task' %>
    </div>

    <div class="form-group">
      <label class="form-label">Task Title *</label>
      <input type="text" name="title" class="form-control" placeholder="What needs to be done?" required autofocus value="<%= titleValue %>">
    </div>

    <div class="grid-2">
      <div class="form-group">
        <label class="form-label">Category</label>
        <select name="category_id" class="form-control">
          <option value="">No Category</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat.id %>" <%= currentTask && String(currentTask.category_id) === String(cat.id) ? 'selected' : '' %>><%= cat.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Priority</label>
        <div class="radio-group">
          <input type="radio" name="priority" id="pl" value="low" <%= currentTask && currentTask.priority === 'low' ? 'checked' : '' %>>
          <label for="pl"><span class="r-icon">↓</span> Low</label>
          
          <input type="radio" name="priority" id="pm" value="medium" <%= !currentTask || currentTask.priority === 'medium' ? 'checked' : '' %>>
          <label for="pm"><span class="r-icon">—</span> Medium</label>

          <input type="radio" name="priority" id="ph" value="high" <%= currentTask && currentTask.priority === 'high' ? 'checked' : '' %>>
          <label for="ph"><span class="r-icon">↑</span> High</label>
        </div>
      </div>
    </div>
    
    <div class="grid-2">
      <div class="form-group">
        <label class="form-label">Difficulty Level</label>
        <select name="difficulty" class="form-control">
        <option value="easy" <%= currentTask && currentTask.difficulty === 'easy' ? 'selected' : '' %>>Easy</option>
        <option value="normal" <%= !currentTask || currentTask.difficulty === 'normal' ? 'selected' : '' %>>Normal</option>
        <option value="hard" <%= currentTask && currentTask.difficulty === 'hard' ? 'selected' : '' %>>Hard</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Time Availability</label>
        <select name="availability" class="form-control">
        <option value="flexible" <%= !currentTask || currentTask.availability === 'flexible' ? 'selected' : '' %>>Flexible</option>
        <option value="urgent" <%= currentTask && currentTask.availability === 'urgent' ? 'selected' : '' %>>Urgent</option>
        <option value="weekend" <%= currentTask && currentTask.availability === 'weekend' ? 'selected' : '' %>>Weekend</option>
        </select>
      </div>
    </div>

    <div class="form-group" style="margin-bottom:0">
      <label class="form-label">Description (Optional)</label>
      <textarea name="description" class="form-control" placeholder="Add details, links, or notes here..."><%= descriptionValue %></textarea>
    </div>

    <div class="form-actions">
      <a href="/tasks/hub" class="btn btn-cancel">Cancel</a>
      <button type="submit" class="btn btn-save">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
        <%= submitText %>
      </button>
    </div>
  </form>
</div>
<%- include('footer') %>
