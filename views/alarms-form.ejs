<%- include('header', { currentPath: '/alarms' }) %>
<%
  const selectedDays = alarm && alarm.days_of_week ? alarm.days_of_week.split(',') : [];
%>
<style>.page{padding:32px;max-width:760px;margin:0 auto}.card{background:#111827;border:1px solid #1e293b;border-radius:14px;padding:24px}.fg{margin-bottom:16px}.fg label{display:block;font-size:12px;color:#9ca3af;margin-bottom:7px}.fg input,.fg textarea,.fg select{width:100%;background:#0b0f19;border:1px solid #374151;color:#f9fafb;padding:10px;border-radius:8px}.fg textarea{min-height:100px}.days{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.day{background:#0b0f19;border:1px solid #374151;border-radius:8px;padding:8px;display:flex;gap:6px;align-items:center;font-size:12px}.actions{display:flex;gap:10px;justify-content:flex-end}.btn{padding:10px 14px;border-radius:8px;border:1px solid #374151;text-decoration:none}.primary{background:#4f46e5;color:#fff;border:none}</style>
<div class="page"><a href="/alarms" style="color:#9ca3af;text-decoration:none">← Back to Alarms</a>
<form class="card" method="POST" action="<%= formAction %>"><h1 style="margin-bottom:20px"><%= pageTitle %></h1>
<div class="fg"><label>Title *</label><input type="text" name="title" required value="<%= alarm ? alarm.title : '' %>"></div>
<div class="fg"><label>Message</label><textarea name="message"><%= alarm ? alarm.message || '' : '' %></textarea></div>
<div class="fg"><label>Time *</label><input type="time" name="time_of_day" required value="<%= alarm ? alarm.time_of_day : '' %>"></div>
<div class="fg"><label>Frequency *</label><select name="frequency" id="freq"><option value="daily" <%= !alarm || alarm.frequency==='daily' ? 'selected' : '' %>>Daily</option><option value="weekdays" <%= alarm && alarm.frequency==='weekdays' ? 'selected' : '' %>>Weekdays (Mon-Fri)</option><option value="custom" <%= alarm && alarm.frequency==='custom' ? 'selected' : '' %>>Custom weekdays</option></select></div>
<div class="fg" id="daysWrap">
  <label>Custom weekdays</label>
  <div class="days">
    <% ['MO','TU','WE','TH','FR','SA','SU'].forEach(day => { %>
      <label class="day"><input type="checkbox" name="days_of_week" value="<%= day %>" <%= selectedDays.includes(day) ? 'checked' : '' %>><span><%= day %></span></label>
    <% }) %>
  </div>
</div>
<div class="actions"><a class="btn" href="/alarms">Cancel</a><button class="btn primary" type="submit">Save Alarm</button></div></form></div>
<script>
(function(){
  const freq = document.getElementById('freq');
  const wrap = document.getElementById('daysWrap');
  function toggleDays(){ wrap.style.display = freq.value === 'custom' ? 'block' : 'none'; }
  freq.addEventListener('change', toggleDays);
  toggleDays();
})();
</script>
<%- include('footer') %>
