<%- include('header', { currentPath: '/alarms' }) %>
<%
  const selectedDays = alarm && alarm.days_of_week ? alarm.days_of_week.split(',') : [];
%>
<div class="page page-center">
  <a href="/alarms" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Alarms</a>
  <div class="form-card card">
    <div class="form-header">
      <i class="fas fa-<%= alarm ? 'edit' : 'bell' %>" aria-hidden="true"></i>
      <h1><%= pageTitle %></h1>
    </div>
    <form method="POST" action="<%= formAction %>" id="alarmForm">
      <div class="fg">
        <label for="alarmTitle">Title <span class="required">*</span></label>
        <input id="alarmTitle" type="text" name="title" required placeholder="e.g. Wake up, Take medication" value="<%= alarm ? alarm.title : '' %>">
      </div>
      <div class="form-row">
        <div class="fg">
          <label for="alarmTime">Time of Day <span class="required">*</span></label>
          <input id="alarmTime" type="time" name="time_of_day" required value="<%= alarm ? alarm.time_of_day : '' %>">
        </div>
        <div class="fg">
          <label for="alarmFreq">Frequency <span class="required">*</span></label>
          <select id="alarmFreq" name="frequency">
            <option value="daily" <%= !alarm || alarm.frequency==='daily' ? 'selected' : '' %>>Daily</option>
            <option value="weekdays" <%= alarm && alarm.frequency==='weekdays' ? 'selected' : '' %>>Weekdays (Mon-Fri)</option>
            <option value="custom" <%= alarm && alarm.frequency==='custom' ? 'selected' : '' %>>Custom weekdays</option>
          </select>
        </div>
      </div>
      <div class="fg" id="daysWrap" style="display:none;">
        <label>Custom Weekdays</label>
        <div class="days-grid">
          <% ['MO','TU','WE','TH','FR','SA','SU'].forEach(day => { %>
            <label class="day-checkbox">
              <input type="checkbox" name="days_of_week" value="<%= day %>" <%= selectedDays.includes(day) ? 'checked' : '' %>>
              <span class="day-label"><%= day %></span>
            </label>
          <% }) %>
        </div>
      </div>
      <div class="fg">
        <label for="alarmMsg">Message (Optional)</label>
        <textarea id="alarmMsg" name="message" placeholder="Details to show when the alarm triggers..." rows="3"><%= alarm ? alarm.message || '' : '' %></textarea>
      </div>
      <div class="form-actions">
        <a class="btn secondary" href="/alarms" id="cancelAlarmBtn"><i class="fas fa-times" aria-hidden="true"></i> Cancel</a>
        <button class="btn primary" type="submit" id="saveAlarmBtn"><i class="fas fa-save" aria-hidden="true"></i> Save Alarm</button>
      </div>
    </form>
  </div>
</div>
<script>
(function(){
  const freq = document.getElementById('alarmFreq');
  const wrap = document.getElementById('daysWrap');
  function toggleDays(){ wrap.style.display = freq.value === 'custom' ? 'block' : 'none'; }
  freq.addEventListener('change', toggleDays);
  toggleDays();
})();
</script>
<%- include('footer') %>
