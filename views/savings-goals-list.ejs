<%- include('header', { currentPath: '/savings-goals' }) %>
<div class="page">
  <div class="top">
    <div>
      <a href="/modules/finance" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Finance Tracker</a>
      <h1><i class="fas fa-piggy-bank" aria-hidden="true"></i> Savings Goals</h1>
      <div class="page-desc">Create savings goals and monitor your progress toward each one.</div>
    </div>
    <a class="btn primary" href="/savings-goals/new" id="newSavingsGoalBtn"><i class="fas fa-plus" aria-hidden="true"></i> New Savings Goal</a>
  </div>

  <% if(goals.length){ %>
  <div class="list">
    <% goals.forEach(g => { %>
    <div class="item" style="flex-direction:column;align-items:stretch;gap:14px;">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;">
        <div class="item-body">
          <div class="item-title"><%= g.name %></div>
          <div class="meta">
            <span class="amount-income">$<%= g.savedAmount.toFixed(2) %></span> of <span>$<%= parseFloat(g.target_amount).toFixed(2) %></span>
            <% if(g.target_date){ %><span><i class="fas fa-flag-checkered" aria-hidden="true"></i> By <%= new Date(g.target_date).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></span><% } %>
          </div>
        </div>
        <div class="actions">
          <a href="/savings-goals/edit/<%= g.id %>" class="btn secondary btn-sm" id="editSavingsGoal<%= g.id %>"><i class="fas fa-plus" aria-hidden="true"></i> Add Funds / Edit</a>
          <form method="POST" action="/savings-goals/delete/<%= g.id %>" style="display:inline" onsubmit="return confirm('Delete this savings goal and all its contributions?');">
            <button type="submit" class="btn danger btn-sm" id="deleteSavingsGoal<%= g.id %>"><i class="fas fa-trash-alt" aria-hidden="true"></i> Delete</button>
          </form>
        </div>
      </div>
      <div class="progress-track"><div class="progress-fill" style="width:<%= g.progressPercent %>%"></div></div>
      <span style="font-size:12px;color:var(--text-muted);font-weight:600;"><%= g.progressPercent %>% saved</span>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="empty-state">
    <div class="empty-icon"><i class="fas fa-piggy-bank" aria-hidden="true"></i></div>
    <h3>No savings goals yet</h3>
    <p>Create a savings goal and log contributions as you save toward it.</p>
    <a href="/savings-goals/new" class="btn primary" id="createFirstSavingsGoal"><i class="fas fa-plus" aria-hidden="true"></i> Create Savings Goal</a>
  </div>
  <% } %>
</div>
<%- include('footer') %>
