<%- include('header', { currentPath: '/journal' }) %>
<%
  const moodMap = { great: '😄', good: '🙂', okay: '😐', low: '😕', bad: '😞' };
%>
<div class="page">
  <div class="top">
    <div>
      <a href="/dashboard" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Dashboard</a>
      <h1><i class="fas fa-pen" aria-hidden="true"></i> Personal Journal</h1>
      <div class="page-desc">Write daily reflections and look back on them anytime.</div>
    </div>
    <a class="btn primary" href="/journal/new" id="newEntryBtn"><i class="fas fa-plus" aria-hidden="true"></i> New Entry</a>
  </div>

  <div class="summary-strip" style="margin-bottom:32px;">
    <div class="summary-tile"><div class="val"><%= daysWritten %>/30</div><div class="lbl">Days Written (last 30)</div></div>
  </div>

  <form class="search-bar" method="GET" action="/journal" role="search" aria-label="Search journal entries">
    <div class="search-input-wrap">
      <i class="fas fa-search search-icon" aria-hidden="true"></i>
      <input type="text" id="searchJournal" name="q" placeholder="Search entries by title or content..." value="<%= q || '' %>">
    </div>
    <button type="submit" class="btn primary" id="searchJournalBtn"><i class="fas fa-search" aria-hidden="true"></i> Search</button>
    <% if(q){ %>
    <a class="btn secondary" href="/journal" id="clearJournalSearchBtn"><i class="fas fa-times" aria-hidden="true"></i> Clear</a>
    <% } %>
  </form>

  <% if(entries.length){ %>
  <div class="list">
    <% entries.forEach(entry => { %>
    <div class="item">
      <div class="item-body">
        <div class="item-title">
          <% if(entry.mood_tag && moodMap[entry.mood_tag]){ %><%= moodMap[entry.mood_tag] %><% } %>
          <%= entry.title %>
        </div>
        <div class="meta">
          <i class="fas fa-calendar-day" aria-hidden="true"></i> <%= new Date(entry.entry_date).toLocaleDateString('en-US', {weekday:'long', month:'short', day:'numeric', year:'numeric'}) %>
        </div>
        <% if(entry.content){ %>
        <div class="meta item-desc"><%= entry.content.length > 160 ? entry.content.substring(0,160) + '...' : entry.content %></div>
        <% } %>
      </div>
      <div class="actions">
        <a href="/journal/edit/<%= entry.id %>" class="btn secondary btn-sm" id="editEntry<%= entry.id %>"><i class="fas fa-edit" aria-hidden="true"></i> Edit</a>
        <form method="POST" action="/journal/delete/<%= entry.id %>" style="display:inline" onsubmit="return confirm('Delete this journal entry?');">
          <button type="submit" class="btn danger btn-sm" id="deleteEntry<%= entry.id %>"><i class="fas fa-trash-alt" aria-hidden="true"></i> Delete</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="empty-state">
    <div class="empty-icon"><i class="fas fa-pen" aria-hidden="true"></i></div>
    <h3>No journal entries found</h3>
    <p><% if(q){ %>No results for "<%= q %>". Try a different search.<% } else { %>Write your first journal entry to get started.<% } %></p>
    <a href="/journal/new" class="btn primary" id="createFirstEntry"><i class="fas fa-plus" aria-hidden="true"></i> Write Entry</a>
  </div>
  <% } %>
</div>
<%- include('footer') %>
