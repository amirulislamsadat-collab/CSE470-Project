<%- include('header', { currentPath: '/subjects' }) %>
<div class="page page-center">
  <a href="/subjects" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Subjects</a>
  <div class="form-card card">
    <div class="form-header">
      <i class="fas fa-<%= subject ? 'edit' : 'book' %>" aria-hidden="true"></i>
      <h1><%= pageTitle %></h1>
    </div>
    <form method="POST" action="<%= formAction %>" id="subjectForm">
      <div class="fg">
        <label for="subjectName">Name <span class="required">*</span></label>
        <input id="subjectName" type="text" name="name" required placeholder="e.g. Physics, Data Structures" value="<%= subject ? subject.name : '' %>">
      </div>
      <div class="fg">
        <label for="subjectCode">Code</label>
        <input id="subjectCode" type="text" name="code" placeholder="e.g. PHY101, CSE470" value="<%= subject ? subject.code || '' : '' %>">
      </div>
      <div class="fg">
        <label for="subjectInst">Instructor</label>
        <input id="subjectInst" type="text" name="instructor" placeholder="e.g. Dr. Smith" value="<%= subject ? subject.instructor || '' : '' %>">
      </div>
      <div class="form-actions">
        <a class="btn secondary" href="/subjects" id="cancelSubjectBtn"><i class="fas fa-times" aria-hidden="true"></i> Cancel</a>
        <button class="btn primary" type="submit" id="saveSubjectBtn"><i class="fas fa-save" aria-hidden="true"></i> Save Subject</button>
      </div>
    </form>
  </div>
</div>
<%- include('footer') %>
