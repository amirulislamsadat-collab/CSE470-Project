<%- include('header', { currentPath: '/calendar' }) %>
<style>.page{padding:32px;max-width:760px;margin:0 auto}.card{background:#111827;border:1px solid #1e293b;border-radius:14px;padding:24px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.fg{margin-bottom:16px}.fg label{display:block;font-size:12px;color:#9ca3af;margin-bottom:7px}.fg input,.fg textarea{width:100%;background:#0b0f19;border:1px solid #374151;color:#f9fafb;padding:10px;border-radius:8px}.fg textarea{min-height:100px}.actions{display:flex;gap:10px;justify-content:flex-end}.btn{padding:10px 14px;border-radius:8px;border:1px solid #374151;text-decoration:none}.primary{background:#4f46e5;color:#fff;border:none}</style>
<div class="page">
  <a href="/calendar" style="color:#9ca3af;text-decoration:none">← Back to Calendar</a>
  <form class="card" method="POST" action="<%= formAction %>">
    <h1 style="margin-bottom:20px"><%= pageTitle %></h1>
    <div class="fg"><label>Event Title *</label><input type="text" name="title" required value="<%= event ? event.title : '' %>"></div>
    <div class="grid">
      <div class="fg"><label>Start *</label><input type="datetime-local" name="start_time" required value="<%= event ? new Date(event.start_time).toISOString().slice(0,16) : '' %>"></div>
      <div class="fg"><label>End *</label><input type="datetime-local" name="end_time" required value="<%= event ? new Date(event.end_time).toISOString().slice(0,16) : '' %>"></div>
    </div>
    <div class="fg"><label>Location</label><input type="text" name="location" value="<%= event ? event.location || '' : '' %>"></div>
    <div class="fg"><label>Description</label><textarea name="description"><%= event ? event.description || '' : '' %></textarea></div>
    <div class="actions"><a class="btn" href="/calendar">Cancel</a><button class="btn primary" type="submit">Save Event</button></div>
  </form>
</div>
<%- include('footer') %>
