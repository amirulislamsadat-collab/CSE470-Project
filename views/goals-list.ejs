<%- include('header', { currentPath: '/goals' }) %>
<div class="page">
  <div class="top">
    <div>
      <a href="/dashboard" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Dashboard</a>
      <h1><i class="fas fa-bullseye" aria-hidden="true"></i> Goals</h1>
      <div class="page-desc">Set personal goals, track progress, and celebrate milestones.</div>
    </div>
    <a class="btn primary" href="/goals/new" id="newGoalBtn"><i class="fas fa-plus" aria-hidden="true"></i> New Goal</a>
  </div>

  <div class="summary-strip" style="margin-bottom:32px;">
    <div class="summary-tile"><div class="val"><%= stats.total %></div><div class="lbl">Total Goals</div></div>
    <div class="summary-tile"><div class="val"><%= stats.completed %></div><div class="lbl">Completed</div></div>
    <div class="summary-tile"><div class="val"><%= stats.overdue %></div><div class="lbl">Overdue</div></div>
  </div>

  <% if(goals.length){ %>
  <div class="list">
    <% goals.forEach(g => { %>
    <div class="item" style="flex-direction:column;align-items:stretch;gap:14px;">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;">
        <div class="item-body">
          <div class="item-title"><%= g.title %></div>
          <div class="meta">
            <span class="badge-progress <%= g.status %>"><%= g.status.replace('_',' ') %></span>
            <% if(g.target_date){ %><span><i class="fas fa-flag-checkered" aria-hidden="true"></i> Target: <%= new Date(g.target_date).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></span><% } %>
          </div>
          <% if(g.description){ %><div class="meta item-desc"><%= g.description %></div><% } %>
        </div>
        <div class="actions">
          <a href="/goals/edit/<%= g.id %>" class="btn secondary btn-sm" id="editGoal<%= g.id %>"><i class="fas fa-edit" aria-hidden="true"></i> Edit</a>
          <form method="POST" action="/goals/delete/<%= g.id %>" style="display:inline" onsubmit="return confirm('Delete this goal?');">
            <button type="submit" class="btn danger btn-sm" id="deleteGoal<%= g.id %>"><i class="fas fa-trash-alt" aria-hidden="true"></i> Delete</button>
          </form>
        </div>
      </div>

      <div>
        <div class="progress-track"><div class="progress-fill" style="width:<%= g.progress_percent %>%"></div></div>
      </div>

      <% if(g.progress_percent < 100){ %>
      <div style="display:flex;gap:8px;align-items:center;">
        <span style="font-size:12px;color:var(--text-muted);font-weight:600;"><%= g.progress_percent %>% complete &mdash; quick update:</span>
        <% [10, 25].forEach(step => { %>
        <form method="POST" action="/goals/progress/<%= g.id %>" style="display:inline">
          <input type="hidden" name="progress_percent" value="<%= Math.min(100, g.progress_percent + step) %>">
          <button type="submit" class="btn secondary btn-sm" id="bump<%= step %>Goal<%= g.id %>">+<%= step %>%</button>
        </form>
        <% }) %>
        <form method="POST" action="/goals/progress/<%= g.id %>" style="display:inline">
          <input type="hidden" name="progress_percent" value="100">
          <button type="submit" class="btn secondary btn-sm habit-checkin-btn" id="completeGoal<%= g.id %>"><i class="fas fa-check" aria-hidden="true"></i> Mark Complete</button>
        </form>
      </div>
      <% } %>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="empty-state">
    <div class="empty-icon"><i class="fas fa-bullseye" aria-hidden="true"></i></div>
    <h3>No goals yet</h3>
    <p>Set a personal goal and track your progress toward it.</p>
    <a href="/goals/new" class="btn primary" id="createFirstGoal"><i class="fas fa-plus" aria-hidden="true"></i> Create Goal</a>
  </div>
  <% } %>
</div>
<%- include('footer') %>
