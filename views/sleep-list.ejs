<%- include('header', { currentPath: '/sleep' }) %>
<div class="page">
  <div class="top">
    <div>
      <a href="/modules/health" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Health &amp; Wellness</a>
      <h1><i class="fas fa-bed" aria-hidden="true"></i> Sleep Tracking</h1>
      <div class="page-desc">Record your daily sleep duration and sleep schedule.</div>
    </div>
    <a class="btn primary" href="/sleep/new" id="newSleepBtn"><i class="fas fa-plus" aria-hidden="true"></i> Log Sleep</a>
  </div>

  <div class="summary-strip" style="margin-bottom:32px;">
    <div class="summary-tile">
      <div class="val"><%= (avgMinutes/60).toFixed(1) %>h</div>
      <div class="lbl">7-Day Average</div>
    </div>
  </div>

  <% if(logs.length){ %>
  <div class="list">
    <% logs.forEach(log => { %>
    <div class="item">
      <div class="item-body">
        <div class="item-title"><%= new Date(log.sleep_date).toLocaleDateString('en-US', {weekday:'long', month:'short', day:'numeric'}) %></div>
        <div class="meta">
          <span><i class="fas fa-moon" aria-hidden="true"></i> Bed: <%= log.bedtime.slice(0,5) %></span>
          <span><i class="fas fa-sun" aria-hidden="true"></i> Wake: <%= log.wake_time.slice(0,5) %></span>
          <span><i class="fas fa-hourglass-half" aria-hidden="true"></i> <%= Math.floor(log.duration_minutes/60) %>h <%= log.duration_minutes%60 %>m</span>
          <span class="badge-progress <%= log.quality === 'great' || log.quality === 'good' ? 'completed' : (log.quality === 'poor' || log.quality === 'bad' ? 'missed' : 'pending') %>"><%= log.quality %></span>
          <%
            // Compare this night against the 7-day average so it's easy to spot
            // whether a given entry was an unusually short or long night.
            var diffVsAvg = avgMinutes ? (log.duration_minutes - avgMinutes) : 0;
          %>
          <% if(avgMinutes && Math.abs(diffVsAvg) >= 15){ %>
          <span class="<%= diffVsAvg > 0 ? 'amount-income' : 'amount-expense' %>" style="font-size:12px;">
            <i class="fas fa-<%= diffVsAvg > 0 ? 'arrow-up' : 'arrow-down' %>" aria-hidden="true"></i>
            <%= Math.abs(Math.round(diffVsAvg)) %> min <%= diffVsAvg > 0 ? 'more' : 'less' %> than usual
          </span>
          <% } %>
        </div>
        <% if(log.notes){ %><div class="meta item-desc"><%= log.notes %></div><% } %>
      </div>
      <div class="actions">
        <a href="/sleep/edit/<%= log.id %>" class="btn secondary btn-sm" id="editSleep<%= log.id %>"><i class="fas fa-edit" aria-hidden="true"></i> Edit</a>
        <form method="POST" action="/sleep/delete/<%= log.id %>" style="display:inline" onsubmit="return confirm('Delete this sleep log?');">
          <button type="submit" class="btn danger btn-sm" id="deleteSleep<%= log.id %>"><i class="fas fa-trash-alt" aria-hidden="true"></i> Delete</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="empty-state">
    <div class="empty-icon"><i class="fas fa-bed" aria-hidden="true"></i></div>
    <h3>No sleep logs yet</h3>
    <p>Log your bedtime and wake time to start tracking your sleep.</p>
    <a href="/sleep/new" class="btn primary" id="createFirstSleep"><i class="fas fa-plus" aria-hidden="true"></i> Log Sleep</a>
  </div>
  <% } %>
</div>
<%- include('footer') %>
