<%- include('header', { currentPath: '/water' }) %>
<div class="page page-center">
  <a href="/water" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Water Intake</a>
  <div class="form-card card">
    <div class="form-header">
      <i class="fas fa-edit" aria-hidden="true"></i>
      <h1><%= pageTitle %></h1>
    </div>
    <form method="POST" action="<%= formAction %>" id="waterForm">
      <div class="fg">
        <label for="wDate">Date <span class="required">*</span></label>
        <input id="wDate" type="date" name="log_date" required value="<%= new Date(log.log_date).toISOString().slice(0,10) %>">
      </div>
      <div class="fg">
        <label for="wAmount">Amount (ml) <span class="required">*</span></label>
        <input id="wAmount" type="number" name="amount_ml" min="1" required value="<%= log.amount_ml %>">
      </div>
      <div class="form-actions">
        <a class="btn secondary" href="/water" id="cancelWaterBtn"><i class="fas fa-times" aria-hidden="true"></i> Cancel</a>
        <button class="btn primary" type="submit" id="saveWaterBtn"><i class="fas fa-save" aria-hidden="true"></i> Save</button>
      </div>
    </form>
  </div>
</div>
<%- include('footer') %>
