<%- include('header', { currentPath: '/exercise' }) %>
<div class="page page-center">
  <a href="/exercise" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Exercise Tracking</a>
  <div class="form-card card">
    <div class="form-header">
      <i class="fas fa-<%= log ? 'edit' : 'running' %>" aria-hidden="true"></i>
      <h1><%= pageTitle %></h1>
    </div>
    <form method="POST" action="<%= formAction %>" id="exerciseForm">
      <div class="form-row">
        <div class="fg">
          <label for="exDate">Date <span class="required">*</span></label>
          <input id="exDate" type="date" name="log_date" required value="<%= log ? new Date(log.log_date).toISOString().slice(0,10) : new Date().toISOString().slice(0,10) %>">
        </div>
        <div class="fg">
          <label for="exActivity">Activity <span class="required">*</span></label>
          <input id="exActivity" type="text" name="activity_type" required placeholder="e.g. Running, Cycling, Gym" value="<%= log ? log.activity_type : '' %>">
        </div>
      </div>
      <div class="form-row">
        <div class="fg">
          <label for="exDuration">Duration (minutes) <span class="required">*</span></label>
          <input id="exDuration" type="number" name="duration_minutes" min="1" required value="<%= log ? log.duration_minutes : '' %>">
        </div>
        <div class="fg">
          <label for="exIntensity">Intensity</label>
          <select id="exIntensity" name="intensity">
            <option value="light" <%= log && log.intensity==='light' ? 'selected' : '' %>>Light</option>
            <option value="moderate" <%= !log || log.intensity==='moderate' ? 'selected' : '' %>>Moderate</option>
            <option value="intense" <%= log && log.intensity==='intense' ? 'selected' : '' %>>Intense</option>
          </select>
        </div>
      </div>
      <div class="fg">
        <label for="exCalories">Calories Burned (optional)</label>
        <input id="exCalories" type="number" name="calories_burned" min="0" value="<%= log && log.calories_burned ? log.calories_burned : '' %>">
      </div>
      <div class="fg">
        <label for="exNotes">Notes</label>
        <textarea id="exNotes" name="notes" placeholder="How did it feel? Any details worth remembering..." rows="3"><%= log ? log.notes || '' : '' %></textarea>
      </div>
      <div class="form-actions">
        <a class="btn secondary" href="/exercise" id="cancelExerciseBtn"><i class="fas fa-times" aria-hidden="true"></i> Cancel</a>
        <button class="btn primary" type="submit" id="saveExerciseBtn"><i class="fas fa-save" aria-hidden="true"></i> Save Exercise Log</button>
      </div>
    </form>
  </div>
</div>
<%- include('footer') %>
