<%- include('header', { currentPath: '/reminders' }) %>
<div class="page page-center">
  <a href="/reminders" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Reminders</a>
  <div class="form-card card">
    <div class="form-header">
      <i class="fas fa-<%= reminder ? 'edit' : 'clock' %>" aria-hidden="true"></i>
      <h1><%= pageTitle %></h1>
    </div>
    <form method="POST" action="<%= formAction %>" id="reminderForm">
      <div class="fg">
        <label for="reminderTitle">Title <span class="required">*</span></label>
        <input id="reminderTitle" type="text" name="title" required placeholder="e.g. Submit assignment, Call dentist" value="<%= reminder ? reminder.title : '' %>">
      </div>
      <div class="fg">
        <label for="reminderDue">Due Date & Time <span class="required">*</span></label>
        <input id="reminderDue" type="datetime-local" name="due_at" required value="<%= reminder ? new Date(reminder.due_at).toISOString().slice(0,16) : '' %>">
      </div>
      <div class="fg">
        <label for="reminderMsg">Message (Optional)</label>
        <textarea id="reminderMsg" name="message" placeholder="Any additional details or notes..." rows="4"><%= reminder ? reminder.message || '' : '' %></textarea>
      </div>
      <div class="form-actions">
        <a class="btn secondary" href="/reminders" id="cancelReminderBtn"><i class="fas fa-times" aria-hidden="true"></i> Cancel</a>
        <button class="btn primary" type="submit" id="saveReminderBtn"><i class="fas fa-save" aria-hidden="true"></i> Save Reminder</button>
      </div>
    </form>
  </div>
</div>
<%- include('footer') %>
