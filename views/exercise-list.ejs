<%- include('header', { currentPath: '/exercise' }) %>
<div class="page">
  <div class="top">
    <div>
      <a href="/modules/health" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Health &amp; Wellness</a>
      <h1><i class="fas fa-running" aria-hidden="true"></i> Exercise Tracking</h1>
      <div class="page-desc">Record your daily physical activities.</div>
    </div>
    <a class="btn primary" href="/exercise/new" id="newExerciseBtn"><i class="fas fa-plus" aria-hidden="true"></i> Log Exercise</a>
  </div>

  <div class="summary-strip" style="margin-bottom:32px;">
    <div class="summary-tile"><div class="val"><%= weeklyMinutes %> min</div><div class="lbl">Active Minutes (7 days)</div></div>
  </div>

  <% if(logs.length){ %>
  <div class="list">
    <% logs.forEach(log => { %>
    <div class="item">
      <div class="item-body">
        <div class="item-title"><%= log.activity_type %></div>
        <div class="meta">
          <span><i class="fas fa-calendar-day" aria-hidden="true"></i> <%= new Date(log.log_date).toLocaleDateString('en-US', {weekday:'short', month:'short', day:'numeric'}) %></span>
          <span><i class="fas fa-hourglass-half" aria-hidden="true"></i> <%= log.duration_minutes %> min</span>
          <span class="badge-priority <%= log.intensity === 'intense' ? 'high' : (log.intensity === 'light' ? 'low' : 'medium') %>"><%= log.intensity %></span>
          <%
            // A rough calories-per-minute figure so two workouts of different
            // lengths can be compared at a glance, not just total calories.
            var calPerMin = (log.calories_burned && log.duration_minutes) ? (log.calories_burned / log.duration_minutes) : null;
          %>
          <% if(log.calories_burned){ %>
          <span><i class="fas fa-fire" aria-hidden="true"></i> <%= log.calories_burned %> kcal<% if(calPerMin){ %> (<%= calPerMin.toFixed(1) %>/min)<% } %></span>
          <% } %>
        </div>
        <% if(log.notes){ %><div class="meta item-desc"><%= log.notes %></div><% } %>
      </div>
      <div class="actions">
        <a href="/exercise/edit/<%= log.id %>" class="btn secondary btn-sm" id="editExercise<%= log.id %>"><i class="fas fa-edit" aria-hidden="true"></i> Edit</a>
        <form method="POST" action="/exercise/delete/<%= log.id %>" style="display:inline" onsubmit="return confirm('Delete this exercise log?');">
          <button type="submit" class="btn danger btn-sm" id="deleteExercise<%= log.id %>"><i class="fas fa-trash-alt" aria-hidden="true"></i> Delete</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="empty-state">
    <div class="empty-icon"><i class="fas fa-running" aria-hidden="true"></i></div>
    <h3>No exercise logged yet</h3>
    <p>Log a workout or activity to start tracking your fitness.</p>
    <a href="/exercise/new" class="btn primary" id="createFirstExercise"><i class="fas fa-plus" aria-hidden="true"></i> Log Exercise</a>
  </div>
  <% } %>
</div>
<%- include('footer') %>
