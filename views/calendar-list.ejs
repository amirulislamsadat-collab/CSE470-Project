<%- include('header', { currentPath: '/calendar' }) %>
<style>.page{padding:32px;max-width:1100px;margin:0 auto}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.btn{background:#4f46e5;color:#fff;text-decoration:none;padding:10px 16px;border-radius:8px;font-size:13px;font-weight:600}.list{display:flex;flex-direction:column;gap:12px}.item{background:#111827;border:1px solid #1e293b;border-radius:12px;padding:16px;display:flex;justify-content:space-between;gap:20px}.title{font-size:16px;font-weight:700}.meta{font-size:13px;color:#9ca3af;margin-top:6px}.actions{display:flex;align-items:center;gap:8px}.actions a,.actions button{background:#0b0f19;border:1px solid #374151;color:#e5e7eb;padding:6px 10px;border-radius:6px;font-size:12px;text-decoration:none;cursor:pointer}.danger{color:#f87171;border-color:#7f1d1d}</style>
<div class="page">
  <div class="top">
    <div><h1>Calendar Events</h1><div style="color:#9ca3af;font-size:13px">Manage events and avoid conflicts.</div></div>
    <a href="/calendar/new" class="btn">+ New Event</a>
  </div>
  <% if(events.length){ %><div class="list">
    <% events.forEach(event => { %>
      <div class="item">
        <div>
          <div class="title"><%= event.title %></div>
          <div class="meta"><%= new Date(event.start_time).toLocaleString() %> → <%= new Date(event.end_time).toLocaleString() %></div>
          <% if(event.location){ %><div class="meta">📍 <%= event.location %></div><% } %>
          <% if(event.description){ %><div class="meta"><%= event.description %></div><% } %>
        </div>
        <div class="actions">
          <a href="/calendar/edit/<%= event.id %>">Edit</a>
          <form method="POST" action="/calendar/delete/<%= event.id %>" onsubmit="return confirm('Delete this event?');"><button type="submit" class="danger">Delete</button></form>
        </div>
      </div>
    <% }) %>
  </div><% } else { %>
    <div style="background:#111827;border:1px solid #1e293b;border-radius:12px;padding:28px;color:#9ca3af">No calendar events found.</div>
  <% } %>
</div>
<%- include('footer') %>
