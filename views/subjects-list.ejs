<%- include('header', { currentPath: '/subjects' }) %>
<style>.page{padding:32px;max-width:1000px;margin:0 auto}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.btn{background:#4f46e5;color:#fff;text-decoration:none;padding:10px 16px;border-radius:8px;font-size:13px;font-weight:600}.list{display:flex;flex-direction:column;gap:12px}.item{background:#111827;border:1px solid #1e293b;border-radius:12px;padding:16px;display:flex;justify-content:space-between;gap:20px}.meta{font-size:13px;color:#9ca3af;margin-top:6px}.actions{display:flex;gap:8px}.actions a,.actions button{background:#0b0f19;border:1px solid #374151;color:#e5e7eb;padding:6px 10px;border-radius:6px;font-size:12px;text-decoration:none;cursor:pointer}.danger{color:#f87171;border-color:#7f1d1d}</style>
<div class="page"><div class="top"><div><h1>Subjects</h1><div style="color:#9ca3af;font-size:13px">Manage your study subjects.</div></div><a class="btn" href="/subjects/new">+ New Subject</a></div>
<% if(subjects.length){ %><div class="list"><% subjects.forEach(subject => { %><div class="item"><div><div style="font-size:16px;font-weight:700"><%= subject.name %></div><% if(subject.code){ %><div class="meta">Code: <%= subject.code %></div><% } %><% if(subject.instructor){ %><div class="meta">Instructor: <%= subject.instructor %></div><% } %></div><div class="actions"><a href="/subjects/edit/<%= subject.id %>">Edit</a><form method="POST" action="/subjects/delete/<%= subject.id %>" onsubmit="return confirm('Delete this subject?');"><button class="danger" type="submit">Delete</button></form></div></div><% }) %></div><% } else { %><div style="background:#111827;border:1px solid #1e293b;border-radius:12px;padding:28px;color:#9ca3af">No subjects found.</div><% } %></div>
<%- include('footer') %>
