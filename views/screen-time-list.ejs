<%- include('header', { currentPath: '/screen-time' }) %>
<div class="page">
  <div class="top">
    <div>
      <a href="/modules/screentime" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Digital Wellbeing</a>
      <h1><i class="fas fa-hourglass-half" aria-hidden="true"></i> Screen Time</h1>
      <div class="page-desc">Manually record your daily device usage.</div>
    </div>
    <a class="btn primary" href="/screen-time/new" id="newScreenTimeBtn"><i class="fas fa-plus" aria-hidden="true"></i> Log Screen Time</a>
  </div>

  <% if(logs.length){ %>
  <div class="list">
    <% logs.forEach(log => { %>
    <div class="item">
      <div class="item-body">
        <div class="item-title"><%= log.activity_name %></div>
        <div class="meta">
          <span><i class="fas fa-calendar-day" aria-hidden="true"></i> <%= new Date(log.log_date).toLocaleDateString('en-US', {weekday:'short', month:'short', day:'numeric'}) %></span>
          <span><i class="fas fa-clock" aria-hidden="true"></i> <%= log.minutes %> min</span>
          <span class="<%= log.category === 'productive' ? 'badge-income' : 'badge-expense' %>"><%= log.category === 'productive' ? 'Productive' : 'Non-Productive' %></span>
        </div>
        <% if(log.notes){ %><div class="meta item-desc"><%= log.notes %></div><% } %>
      </div>
      <div class="actions">
        <a href="/screen-time/edit/<%= log.id %>" class="btn secondary btn-sm" id="editScreenTime<%= log.id %>"><i class="fas fa-edit" aria-hidden="true"></i> Edit</a>
        <form method="POST" action="/screen-time/delete/<%= log.id %>" style="display:inline" onsubmit="return confirm('Delete this screen time log?');">
          <button type="submit" class="btn danger btn-sm" id="deleteScreenTime<%= log.id %>"><i class="fas fa-trash-alt" aria-hidden="true"></i> Delete</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="empty-state">
    <div class="empty-icon"><i class="fas fa-hourglass-half" aria-hidden="true"></i></div>
    <h3>No screen time logged yet</h3>
    <p>Log your device usage to see a productive vs. non-productive breakdown.</p>
    <a href="/screen-time/new" class="btn primary" id="createFirstScreenTime"><i class="fas fa-plus" aria-hidden="true"></i> Log Screen Time</a>
  </div>
  <% } %>
</div>
<%- include('footer') %>
