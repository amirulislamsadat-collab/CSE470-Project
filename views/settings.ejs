<%- include('header') %>
<div class="page">
  <h1 class="page-title">⊙ Module Settings</h1>
  <p class="page-desc">Customize your workspace. Enable or disable features as your needs change.</p>
  <div class="info-box">
    <div class="info-box-head">🛡 Safe Data Preservation</div>
    <p>Don't worry about losing your work! Disabling a module only hides it from your workspace. All your underlying data is safely preserved in the database and will be exactly as you left it when you re-enable the module.</p>
  </div>
  <div class="mods-grid">
    <% modules.forEach(function(mod){ %>
    <div class="mc <%= mod.is_enabled ? 'on' : '' %>">
      <div class="mc-top">
        <div class="mc-icon">
          <%- mod.slug==='tasks'?'<i class="fas fa-tasks"></i>':mod.slug==='study'?'<i class="fas fa-book-open"></i>':mod.slug==='finance'?'<i class="fas fa-money-bill-wave"></i>':mod.slug==='health'?'<i class="fas fa-heart"></i>':mod.slug==='projects'?'<i class="fas fa-chart-bar"></i>':'<i class="fas fa-pencil-alt"></i>' %>
        </div>
        <div class="mc-info">
          <h4><%= mod.name %></h4>
          <p><%= mod.description %></p>
        </div>
      </div>
      <div class="mc-foot">
        <% if(mod.is_enabled){ %>
          <div class="status-on"><div class="sdot green"></div> Enabled</div>
          <form method="POST" action="/settings/toggle/<%= mod.id %>">
            <button type="submit" class="btn-disable">Disable</button>
          </form>
        <% } else { %>
          <div class="status-off"><div class="sdot gray"></div> Disabled</div>
          <form method="POST" action="/settings/toggle/<%= mod.id %>">
            <button type="submit" class="btn-enable">Enable</button>
          </form>
        <% } %>
      </div>
    </div>
    <% }) %>
  </div>
</div>
<%- include('footer') %>
